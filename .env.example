# -----------------------------------------------------------------------------
# Sentry Observability Configuration
# -----------------------------------------------------------------------------
# Public DSN for client-side browser error reporting
# Found in: Sentry -> Project Settings -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""
# DSN for server & edge runtime error reporting (falls back to NEXT_PUBLIC_SENTRY_DSN if unset)
SENTRY_DSN=""
# Sentry Organization & Project slugs (used for sourcemap release tracking)
# Found in: Sentry Organization Settings & Project Settings
SENTRY_ORG=""
SENTRY_PROJECT=""
# Sentry Authentication Token (used in CI/CD for uploading sourcemaps)
# Generated in: Sentry -> User Settings -> API -> Auth Tokens (needs project:releases scope)
SENTRY_AUTH_TOKEN=""

# -----------------------------------------------------------------------------
# GitHub activity section
# -----------------------------------------------------------------------------
# Required for the last-year contribution calendar. GitHub's GraphQL API rejects anonymous calls.
# Create a fine-grained or classic personal access token, and put it in .env.local.
# Do not commit a real token. Name cannot start with GITHUB_ (Actions rejects that prefix).
# Add the same name as a repository secret for CI / production hosts.
GH_ACTIVITY_TOKEN=""

# -----------------------------------------------------------------------------
# Contact form email (Gmail SMTP)
# -----------------------------------------------------------------------------
# The Gmail address that sends both contact emails, and its app password.
# Turn on 2-Step Verification, then create an app password. The normal Gmail
# password will not work. Put the real values in .env.local, not in this file.
# Add the same names as repository secrets for CI. CI can use dummy values.
# Only the live host needs the real app password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
